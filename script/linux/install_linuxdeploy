#!/usr/bin/env bash

set -e

# Ensure the ~/.local/bin directory exists so we can download things into it.
LOCAL_BIN="$HOME/.local/bin"
mkdir -p "$LOCAL_BIN"

# Extract the short commit baked into the linuxdeploy AppImage.
appimage_commit() {
  "$1" --version 2>&1 | grep -oE "git commit ID [0-9a-f]{7,40}" | cut -d' ' -f4
}

# A helper function to download an architecture-dependent AppImage and install
# it in ~/.local/bin.
#
# Usage:
#   download_appimage $BINARY_NAME $VERSION $COMMIT $MIRROR_URL
#
# Args:
#   BINARY_NAME: The name of the AppImage-bundled binary we want to download,
#                e.g.: "linuxdeploy".
#   VERSION:     The upstream release tag (kept for the cache-hit message only).
#   COMMIT:      The (short) commit SHA the release tag points at; used to
#                verify the cached binary matches the pinned version.
#   MIRROR_URL:  Direct URL to the AppImage file. Mirrored under our own
#                infra (not github.com/releases) so this doesn't depend on
#                GitHub's availability from the build runner -- a stalled
#                unbounded fetch here previously hung a CI release for 30+
#                minutes with no timeout and no error.
download_appimage() {
  BINARY_NAME="$1"
  VERSION="$2"
  COMMIT="$3"
  MIRROR_URL="$4"

  APPIMAGE_NAME="$BINARY_NAME-$(uname -m).AppImage"
  APPIMAGE_PATH="$LOCAL_BIN/$APPIMAGE_NAME"

  if [ -x "$APPIMAGE_PATH" ] && [ "$(appimage_commit "$APPIMAGE_PATH")" = "$COMMIT" ]; then
    echo "✅ Found $APPIMAGE_NAME in $LOCAL_BIN (pinned $VERSION)."
  else
    echo "⬇️ Downloading $MIRROR_URL..."
    curl -fL --connect-timeout 15 --max-time 180 "$MIRROR_URL" --output "$APPIMAGE_PATH"
    chmod +x "$APPIMAGE_PATH"
  fi

  # Create a symlink so we can invoke it like a normal binary.
  ln -sf "$APPIMAGE_PATH" "$LOCAL_BIN/$BINARY_NAME"
}

# Install linuxdeploy, a helper for constructing an AppDir (and then invoking
# appimagetool). Mirrored to derp.baby (see comment above) -- originally
# https://github.com/linuxdeploy/linuxdeploy/releases/download/1-alpha-20251107-1/linuxdeploy-x86_64.AppImage
download_appimage "linuxdeploy" "1-alpha-20251107-1" "cc7b864" \
  "https://derp.baby/vendor/linuxdeploy-x86_64.AppImage"

if [ ! -x "$(which linuxdeploy)" ]; then
  echo -e "⚠️  ${red}Please make sure that \"$LOCAL_BIN\" is on your PATH, otherwise some scripts may not work.${reset}"
fi
