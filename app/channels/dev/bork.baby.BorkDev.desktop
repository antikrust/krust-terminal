[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=BorkDev
GenericName=TerminalEmulator

Exec=bork-terminal-dev %U
StartupWMClass=bork.baby.BorkDev

Keywords=shell;prompt;command;commandline;cmd;

Icon=bork.baby.BorkDev

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for borkdev:// URLs.
MimeType=x-scheme-handler/borkdev;
