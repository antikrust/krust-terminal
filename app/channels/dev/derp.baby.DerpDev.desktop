[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=DerpDev
GenericName=TerminalEmulator

Exec=derp-terminal-dev %U
StartupWMClass=derp.baby.DerpDev

Keywords=shell;prompt;command;commandline;cmd;

Icon=derp.baby.DerpDev

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for derpdev:// URLs.
MimeType=x-scheme-handler/derpdev;
