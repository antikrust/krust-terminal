[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=Derp
GenericName=TerminalEmulator

Exec=derp-terminal %U
StartupWMClass=derp.baby.Derp

Keywords=shell;prompt;command;commandline;cmd;

Icon=derp.baby.Derp

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for derp:// URLs.
MimeType=x-scheme-handler/derp;
