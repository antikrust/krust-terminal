[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=Bork
GenericName=TerminalEmulator

Exec=bork-terminal %U
StartupWMClass=bork.baby.Bork

Keywords=shell;prompt;command;commandline;cmd;

Icon=bork.baby.Bork

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for bork:// URLs.
MimeType=x-scheme-handler/bork;
