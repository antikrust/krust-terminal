[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=BorkPreview
GenericName=TerminalEmulator

Exec=bork-terminal-preview %U
StartupWMClass=bork.baby.BorkPreview

Keywords=shell;prompt;command;commandline;cmd;

Icon=bork.baby.BorkPreview

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for borkpreview:// URLs.
MimeType=x-scheme-handler/borkpreview;
