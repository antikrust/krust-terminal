[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=KrustPreview
GenericName=TerminalEmulator

Exec=krust-terminal-preview %U
StartupWMClass=krust.baby.KrustPreview

Keywords=shell;prompt;command;commandline;cmd;

Icon=krust.baby.KrustPreview

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for krustpreview:// URLs.
MimeType=x-scheme-handler/krustpreview;
