[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=DerpPreview
GenericName=TerminalEmulator

Exec=derp-terminal-preview %U
StartupWMClass=baby.derp.DerpPreview

Keywords=shell;prompt;command;commandline;cmd;

Icon=baby.derp.DerpPreview

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for derppreview:// URLs.
MimeType=x-scheme-handler/derppreview;
