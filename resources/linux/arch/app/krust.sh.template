#!/bin/bash

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-~/.config}

# Allow users to override command-line options
if [[ -f $XDG_CONFIG_HOME/krust-terminal@@CHANNEL_SUFFIX@@-flags.conf ]]; then
    KRUST_USER_FLAGS="$(grep -v '^#' $XDG_CONFIG_HOME/krust-terminal@@CHANNEL_SUFFIX@@-flags.conf)"
fi

# Launch
exec /opt/krustdotdev/krust-terminal@@CHANNEL_SUFFIX@@/@@BINARY_NAME@@ $KRUST_USER_FLAGS "$@"
