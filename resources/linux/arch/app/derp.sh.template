#!/bin/bash

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-~/.config}

# Allow users to override command-line options
if [[ -f $XDG_CONFIG_HOME/derp-terminal@@CHANNEL_SUFFIX@@-flags.conf ]]; then
    DERP_USER_FLAGS="$(grep -v '^#' $XDG_CONFIG_HOME/derp-terminal@@CHANNEL_SUFFIX@@-flags.conf)"
fi

# Launch
exec /opt/derpdotdev/derp-terminal@@CHANNEL_SUFFIX@@/@@BINARY_NAME@@ $DERP_USER_FLAGS "$@"
