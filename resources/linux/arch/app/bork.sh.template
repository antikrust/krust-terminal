#!/bin/bash

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-~/.config}

# Allow users to override command-line options
if [[ -f $XDG_CONFIG_HOME/bork-terminal@@CHANNEL_SUFFIX@@-flags.conf ]]; then
    BORK_USER_FLAGS="$(grep -v '^#' $XDG_CONFIG_HOME/bork-terminal@@CHANNEL_SUFFIX@@-flags.conf)"
fi

# Launch
exec /opt/borkdotdev/bork-terminal@@CHANNEL_SUFFIX@@/@@BINARY_NAME@@ $BORK_USER_FLAGS "$@"
